# Azure OpenAI Configuration
# Get these values from your Azure OpenAI resource in the Azure Portal

# Your Azure OpenAI API key
AZURE_OPENAI_API_KEY=your-api-key-here

# Your Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API version (default: 2024-02-15-preview)
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Your deployment name (the name you gave to your model deployment)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
